# ---------------------------------------------------------------------------
# Firelle POS — contoh environment variable.
#
# Salin file ini menjadi `.env.local` lalu isi nilainya. File `.env.local`
# TIDAK ikut di-commit: itulah satu-satunya pembeda antara branch `main`
# (production) dan `demo`. Kode di kedua branch identik.
#
#   cp .env.example .env.local         # macOS / Linux
#   Copy-Item .env.example .env.local  # Windows PowerShell
# ---------------------------------------------------------------------------

# Mode aplikasi: "production" atau "demo".
# Selain "demo" (atau kosong) dianggap production, jadi banner demo tidak
# pernah muncul di production.
APP_MODE=production

# Koneksi Supabase — beda nilai per branch, isi dari dashboard project Supabase
# masing-masing (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Kredensial akun demo untuk tombol "Masuk sebagai demo" di halaman login.
# Hanya dibaca server-side dan hanya dipakai saat APP_MODE=demo.
# Biarkan kosong (atau hapus barisnya) di production.
DEMO_EMAIL=
DEMO_PASSWORD=