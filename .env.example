# ---------------------------------------------------------------------------
# Firelle POS — contoh environment variable.
#
# Salin file ini menjadi `.env.local` lalu isi nilainya. File `.env.local`
# TIDAK ikut di-commit. Satu branch (`main`) dipakai untuk semua mode:
# production terhubung ke Supabase, demo memakai data hardcoded di memori
# browser. Yang membedakan hanya APP_MODE di project deploy. Lihat README.md.
#
#   cp .env.example .env.local         # macOS / Linux
#   Copy-Item .env.example .env.local  # Windows PowerShell
# ---------------------------------------------------------------------------

# Mode aplikasi: "production" atau "demo".
# - production (default): semua data & auth lewat Supabase.
# - demo: data & auth hardcoded di browser (in-memory), TANPA Supabase.
#   Writes hanya bertahan sampai halaman di-reload.
# Selain "demo" (atau kosong) dianggap production, jadi banner demo tidak
# pernah muncul di production. APP_MODE hanya dibaca di server, lalu
# disuntikkan lewat AppModeProvider — jangan pakai prefix NEXT_PUBLIC_.
APP_MODE=production

# Koneksi Supabase — WAJIB di production, tidak dipakai sama sekali di demo.
# Isi dari dashboard project Supabase produksi
# (Project Settings → API). Di demo boleh dikosongkan.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Tidak ada DEMO_EMAIL / DEMO_PASSWORD: akun demo hardcoded di kode
# (demo@firelle.com / demo12345) dan tidak pernah ditulis ke database.
